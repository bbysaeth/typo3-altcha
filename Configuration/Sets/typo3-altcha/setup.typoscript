@import 'EXT:altcha/Configuration/TypoScript/setup.typoscript'

# Override with SET settings
plugin.tx_altcha.settings {
    minimumComplexity = {$altcha.minimumComplexity}
    maximumComplexity = {$altcha.maximumComplexity}
    widgetType = {$altcha.widgetType}
    display = {$altcha.display}
    barPlacement = {$altcha.barPlacement}
    hideAltchaLogo = {$altcha.hideAltchaLogo}
    hideFooter = {$altcha.hideFooter}
    expires = {$altcha.expires}
    auto = {$altcha.auto}
    challengeUrl = {$altcha.challengeUrl}
    verifyUrl = {$altcha.verifyUrl}
    apiKey = {$altcha.apiKey}
}

altcha_local_challenge.config.additionalHeaders.10.header = {$altcha.jsonContentTypeHeader}
altcha_proxy_challenge.config.additionalHeaders.10.header = {$altcha.jsonContentTypeHeader}
altcha_proxy_verify.config.additionalHeaders.10.header = {$altcha.jsonContentTypeHeader}
